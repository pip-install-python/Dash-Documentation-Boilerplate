{
  "model": "opus",
  "sandbox": {
    "network": {
      "allowedDomains": [
        "boilerplate.2plot.dev",
        "2plot.ai",
        "2plot.dev",
        "api.github.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:boilerplate.2plot.dev)",
      "WebFetch(domain:2plot.ai)",
      "WebFetch(domain:2plot.dev)",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(.venv/bin/python *)",
      "Bash(pytest *)",
      "Bash(flake8 *)",
      "Bash(shellcheck *)",
      "Bash(actionlint *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash list*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-parse*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git ls-remote*)",
      "Bash(git clone *)",
      "Bash(git rm --cached *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(env *)",
      "Bash(which *)",
      "Bash(curl *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Bash(git tag*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git merge*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)"
    ]
  }
}
